{
  "name": "farming",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Personal DeFi farming adventure log (docs + Bun SQLite). Not financial advice.",
  "author": {
    "name": "Julrey Rosales",
    "url": "https://github.com/bakajieyan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakajieyan/farming.git"
  },
  "bugs": {
    "url": "https://github.com/bakajieyan/farming/issues"
  },
  "homepage": "https://github.com/bakajieyan/farming#readme",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "prepare": "lefthook install",
    "db:init": "bun scripts/db-init.ts",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/db-init.ts && bun test",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "bun-types": "^1.3.13",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.2.0",
    "oxlint": "1.75.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  }
}
